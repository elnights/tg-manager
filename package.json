{
  "name": "tg-manager-tui",
  "description": "A local terminal app for browsing Telegram chats and managing your own messages.",
  "version": "0.4.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elnights/tg-manager.git"
  },
  "homepage": "https://github.com/elnights/tg-manager#readme",
  "bugs": {
    "url": "https://github.com/elnights/tg-manager/issues"
  },
  "bin": {
    "tg-manager": "dist/cli.js"
  },
  "files": [
    "dist/",
    "docs/",
    "CONTRIBUTING.md"
  ],
  "keywords": ["telegram", "terminal", "tui", "cli", "ink"],
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "repro:emoji": "node --import tsx src/cli.ts --demo",
    "build": "node scripts/build.mjs",
    "test": "FORCE_COLOR=1 node --import tsx --test test/*.test.tsx",
    "test:package": "node --test test/package.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ansi-regex": "^6.5.0",
    "ink": "^8.0.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0",
    "teleproto": "^1.232.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.3.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/headless": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}
